{
  "name": "everme",
  "version": "0.6.1",
  "description": "EverMe — automatic memory recall for Kimi Code. Recalls relevant context from past sessions before each prompt and saves new turns through the EverMe gateway.",
  "interface": {
    "displayName": "EverMe",
    "shortDescription": "Automatic cross-session memory recall + persistence via the EverMe gateway."
  },
  "skills": "./skills/",
  "sessionStart": {
    "skill": "memory-recall"
  },
  "mcpServers": {
    "everme-memory": {
      "command": "node",
      "args": [
        "./hooks/scripts/mcp-launch.mjs"
      ]
    }
  },
  "hooks": [
    {
      "event": "SessionStart",
      "matcher": "startup",
      "command": "node ./hooks/scripts/session-start.mjs",
      "timeout": 30
    },
    {
      "event": "UserPromptSubmit",
      "command": "node ./hooks/scripts/inject-memories.mjs",
      "timeout": 10
    },
    {
      "event": "SessionEnd",
      "command": "node ./hooks/scripts/session-summary.mjs",
      "timeout": 30
    }
  ]
}
