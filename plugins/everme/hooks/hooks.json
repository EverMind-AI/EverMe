{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/hook.mjs\" hook SessionStart",
            "timeout": 30,
            "statusMessage": "Loading EverMe memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/hook.mjs\" hook UserPromptSubmit",
            "timeout": 10,
            "statusMessage": "Searching EverMe memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/hook.mjs\" hook Stop",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/hook.mjs\" hook PreCompact",
            "timeout": 30,
            "statusMessage": "Flushing EverMe memory"
          }
        ]
      }
    ]
  }
}
