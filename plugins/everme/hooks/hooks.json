{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @everme/codex@0.4.1 hook SessionStart",
            "timeout": 30,
            "statusMessage": "Loading EverMe memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @everme/codex@0.4.1 hook UserPromptSubmit",
            "timeout": 10,
            "statusMessage": "Searching EverMe memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @everme/codex@0.4.1 hook Stop",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @everme/codex@0.4.1 hook PreCompact",
            "timeout": 30,
            "statusMessage": "Flushing EverMe memory"
          }
        ]
      }
    ]
  }
}
