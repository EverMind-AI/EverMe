{
  "name": "everme-plugins-workspace",
  "private": true,
  "description": "npm workspace root for EverMe agent plugins. Each subpackage publishes independently; this workspace exists so the SDK is symlinked for local development without `npm pack` round-trips.",
  "workspaces": [
    "agent-sdk",
    "memory-mcp",
    "openclaw",
    "claude-code",
    "kimicode",
    "codex",
    "cursor",
    "devin",
    "dsh",
    "cli"
  ],
  "overrides": {
    "@hono/node-server": "^2.0.11",
    "hono": "^4.13.3",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.4.0"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "test:sdk": "npm test --workspace @everme/agent-sdk",
    "test:mcp": "npm test --workspace @everme/memory-mcp",
    "test:openclaw": "npm test --workspace @everme/openclaw",
    "test:claude-code": "npm test --workspace @everme/claude-code",
    "test:kimicode": "npm test --workspace @everme/kimicode",
    "build:codex-marketplace": "npm run build:marketplace --workspace @everme/codex",
    "test:codex": "npm test --workspace @everme/codex",
    "test:cli": "npm test --workspace @everme/cli",
    "test:cursor": "npm test --workspace @everme/cursor",
    "test:devin": "npm test --workspace @everme/devin",
    "test:dsh": "npm test --workspace @everme/dsh"
  }
}
